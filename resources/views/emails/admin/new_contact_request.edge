<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
      line-height: 1.6;
      color: #374151;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background: #f9fafb;
    }
    .container {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
    .header {
      background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
      color: white;
      padding: 30px 20px;
      text-align: center;
    }
    .header h1 {
      margin: 0 0 5px 0;
      font-size: 24px;
      font-weight: 700;
    }
    .badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.2);
      padding: 5px 15px;
      border-radius: 9999px;
      font-size: 12px;
      margin-top: 10px;
      font-weight: 600;
    }
    .content {
      padding: 30px;
    }
    .info-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 15px;
      margin-bottom: 25px;
      padding: 20px;
      background: #f9fafb;
      border-radius: 12px;
    }
    .info-item {
      display: flex;
      flex-direction: column;
    }
    .info-label {
      font-weight: 600;
      color: #6b7280;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.025em;
      margin-bottom: 4px;
    }
    .info-value {
      color: #111827;
      font-weight: 500;
    }
    .info-value a {
      color: #3b82f6;
      text-decoration: none;
    }
    .info-value a:hover {
      text-decoration: underline;
    }
    .message-box {
      background: #eff6ff;
      border: 1px solid #dbeafe;
      padding: 20px;
      border-radius: 12px;
      margin: 20px 0;
    }
    .message-box h3 {
      margin: 0 0 10px 0;
      color: #1e40af;
      font-size: 16px;
      font-weight: 600;
    }
    .message-content {
      color: #1e3a8a;
      white-space: pre-wrap;
      word-wrap: break-word;
      line-height: 1.6;
    }
    .service-box {
      background: #f0fdf4;
      border: 1px solid #dcfce7;
      padding: 15px;
      border-radius: 12px;
      margin: 20px 0;
    }
    .service-box h3 {
      margin: 0 0 5px 0;
      color: #15803d;
      font-size: 16px;
      font-weight: 600;
    }
    .service-box p {
      margin: 5px 0;
      color: #166534;
      font-size: 14px;
    }
    .service-description {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid #dcfce7;
      color: #166534;
      font-size: 14px;
    }
    .btn-container {
      text-align: center;
      margin: 30px 0;
    }
    .btn {
      display: inline-block;
      background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
      color: white;
      padding: 14px 28px;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.3);
      transition: all 0.2s ease;
      border: none;
      cursor: pointer;
      font-size: 16px;
    }
    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.4);
    }
    .footer {
      background: #f9fafb;
      padding: 20px;
      text-align: center;
      border-top: 1px solid #e5e7eb;
      font-size: 12px;
      color: #6b7280;
    }
    .meta-info {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-top: 15px;
      flex-wrap: wrap;
    }
    .meta-item {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
    }
    @media (max-width: 600px) {
      body {
        padding: 10px;
      }
      .content {
        padding: 20px;
      }
      .info-grid {
        padding: 15px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🔔 Nouvelle Demande de Contact</h1>
      <div class="badge">NOUVEAU</div>
    </div>

    <div class="content">
      <div class="info-grid">
        <div class="info-item">
          <div class="info-label">Nom complet</div>
          <div class="info-value">{{ contactRequest.fullName }}</div>
        </div>

        <div class="info-item">
          <div class="info-label">Email</div>
          <div class="info-value">
            <a href="mailto:{{ contactRequest.email }}">{{ contactRequest.email }}</a>
          </div>
        </div>

        <div class="info-item">
          <div class="info-label">Téléphone</div>
          <div class="info-value">{{ contactRequest.phone || 'Non fourni' }}</div>
        </div>

        <div class="info-item">
          <div class="info-label">Date de réception</div>
          <div class="info-value">{{ formatDate(contactRequest.createdAt, 'full') }}</div>
        </div>
      </div>

      @if(service)
      <div class="service-box">
        <h3>📦 Service concerné</h3>
        <p><strong>{{ service.title }}</strong></p>
        @if(service.price)
        <p>💰 Prix : {{ service.price }}€</p>
        @endif
        @if(service.description)
        <div class="service-description">
          {{{ safeHTML(service.description) }}}
        </div>
        @endif
      </div>
      @endif

      <div class="message-box">
        <h3>💬 Message du client</h3>
        <div class="message-content">{{ contactRequest.message }}</div>
      </div>

      <div class="btn-container">
        <a href="{{ adminUrl }}" class="btn">
          Voir la demande et répondre
        </a>
      </div>

      <div style="text-align: center; color: #6b7280; font-size: 14px; padding: 15px; background: #f3f4f6; border-radius: 8px;">
        💡 <strong>Astuce :</strong> Répondez rapidement pour améliorer la satisfaction client
      </div>
    </div>

    <div class="footer">
      <p>Cette notification a été générée automatiquement.</p>
      <div class="meta-info">
        <div class="meta-item">
          <span>🆔 Demande #{{ contactRequest.id }}</span>
        </div>
        <div class="meta-item">
          <span>🕘 {{ formatDate(contactRequest.createdAt, 'relative') }}</span>
        </div>
      </div>
    </div>
  </div>
</body>
</html>