<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
      line-height: 1.6;
      color: #374151;
      max-width: 650px;
      margin: 0 auto;
      padding: 20px;
      background: #f9fafb;
    }
    .container {
      background: white;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }
    .header {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: white;
      padding: 35px 20px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 26px;
      font-weight: 700;
    }
    .content {
      padding: 35px;
    }
    .greeting {
      font-size: 20px;
      color: #111827;
      margin-bottom: 20px;
      font-weight: 600;
    }
    .reply-box {
      background: #f5f3ff;
      border-left: 4px solid #8b5cf6;
      padding: 25px;
      margin: 30px 0;
      border-radius: 0 12px 12px 0;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .reply-box h3 {
      margin: 0 0 15px 0;
      color: #6d28d9;
      font-size: 18px;
      font-weight: 600;
    }
    .reply-message {
      background: white;
      padding: 20px;
      border-radius: 12px;
      white-space: pre-wrap;
      word-wrap: break-word;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
      border: 1px solid #e5e7eb;
    }
    .original-request {
      margin: 35px 0;
      padding: 25px;
      background: #fefce8;
      border-radius: 12px;
      border: 1px solid #fef08a;
    }
    .original-request h3 {
      margin: 0 0 15px 0;
      color: #854d0e;
      font-size: 18px;
      font-weight: 600;
    }
    .request-details {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 20px;
    }
    .detail-item {
      display: flex;
    }
    .detail-label {
      font-weight: 600;
      color: #854d0e;
      min-width: 100px;
    }
    .detail-value {
      color: #78350f;
    }
    .original-message {
      background: white;
      padding: 20px;
      border-radius: 12px;
      margin-top: 15px;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
      border: 1px solid #e5e7eb;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
    .signature {
      margin-top: 35px;
      padding-top: 25px;
      border-top: 1px solid #e5e7eb;
    }
    .signature-name {
      font-weight: 700;
      color: #111827;
      margin: 5px 0;
    }
    .signature-role {
      color: #6b7280;
      font-size: 14px;
    }
    .tip-box {
      background: #eff6ff;
      border: 1px solid #dbeafe;
      border-radius: 12px;
      padding: 20px;
      margin-top: 25px;
      text-align: center;
    }
    .footer {
      background: #f9fafb;
      padding: 25px;
      text-align: center;
      border-top: 1px solid #e5e7eb;
      font-size: 12px;
      color: #6b7280;
    }
    .request-id {
      font-weight: 600;
    }
    @media (max-width: 600px) {
      body {
        padding: 10px;
      }
      .content {
        padding: 25px;
      }
      .reply-box, .original-request {
        padding: 20px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>💬 Réponse à votre demande</h1>
    </div>

    <div class="content">
      <p class="greeting">Bonjour {{ contactRequest.fullName }},</p>

      <p style="font-size: 16px; color: #374151;">
        Nous vous remercions pour votre demande. Voici notre réponse :
      </p>

      <div class="reply-box">
        <h3>Réponse de notre équipe</h3>
        <div class="reply-message">
          {{ replyMessage }}
        </div>
      </div>

      <div class="original-request">
        <h3>📝 Rappel de votre demande</h3>
        <div class="request-details">
          <div class="detail-item">
            <div class="detail-label">Date :</div>
            <div class="detail-value">{{ formatDate(contactRequest.createdAt, 'full') }}</div>
          </div>

          @if(service)
          <div class="detail-item">
            <div class="detail-label">Service :</div>
            <div class="detail-value">{{ service.title }}</div>
          </div>
          @endif

          <div class="detail-item">
            <div class="detail-label">Statut :</div>
            <div class="detail-value">Traitée</div>
          </div>
        </div>

        <div class="original-message">{{ contactRequest.message }}</div>
      </div>

      <div class="signature">
        <p>Cordialement,</p>
        <p class="signature-name">{{ adminName }}</p>
        <p class="signature-role">Service client</p>
      </div>

      <div class="tip-box">
        <p>
          💡 Vous pouvez répondre directement à cet email pour poursuivre la conversation.
        </p>
      </div>
    </div>

    <div class="footer">
      <p style="margin-top: 10px;">
        © {{ new Date().getFullYear() }} Tous droits réservés
      </p>
    </div>
  </div>
</body>
</html>