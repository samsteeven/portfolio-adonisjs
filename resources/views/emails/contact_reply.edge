<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Réponse à votre demande de contact</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #007bff;
            color: white;
            padding: 20px;
            border-radius: 5px;
            margin-bottom: 20px;
            text-align: center;
        }
        .content {
            background-color: #ffffff;
            padding: 20px;
            border: 1px solid #dee2e6;
            border-radius: 5px;
        }
        .summary {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin: 20px 0;
        }
        .info-row {
            margin-bottom: 10px;
        }
        .label {
            font-weight: bold;
            color: #495057;
        }
        .service-highlight {
            background-color: #e3f2fd;
            padding: 10px;
            border-radius: 3px;
            margin: 10px 0;
        }
        .message {
            background-color: #e9f7ef;
            padding: 15px;
            border-left: 4px solid #28a745;
            border-radius: 3px;
            margin: 20px 0;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #eee;
            color: #666;
        }
        .signature {
            font-style: italic;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>✉ Réponse à votre demande</h1>
        <p>Bonjour {{ contactRequest.fullName }} !</p>
    </div>

    <div class="content">
        <p>Bonjour <strong>{{ contactRequest.fullName }}</strong>,</p>

        <p>Merci pour votre demande de contact. Nous avons bien reçu votre message et nous vous répondons ci-dessous :</p>

        @if(service)
        <div class="service-highlight">
            <p><strong>À propos de votre demande concernant :</strong> {{ service.title }}</p>
        </div>
        @endif

        <div class="message">
            <p><strong>Réponse de {{ adminName }} :</strong></p>
            <p>{{ replyMessage }}</p>
        </div>

        <div class="summary">
            <h3>Rappel de votre demande :</h3>

            <div class="info-row">
                <span class="label">Email :</span> {{ contactRequest.email }}
            </div>

            @if(contactRequest.phone)
            <div class="info-row">
                <span class="label">Téléphone :</span> {{ contactRequest.phone }}
            </div>
            @endif

            <div class="info-row">
                <span class="label">Message :</span> {{ contactRequest.message }}
            </div>

            <div class="info-row">
                <span class="label">Date :</span> {{ new Date(contactRequest.createdAt).toLocaleString('fr-FR') }}
            </div>
        </div>

        <p class="signature">
            Cordialement,<br>
            {{ adminName }}<br>
            L'équipe Portfolio
        </p>

        <p>Si vous avez d'autres questions, n'hésitez pas à répondre directement à cet email.</p>
    </div>

    <div class="footer">
        <p><small>Cet email est une réponse à votre demande de contact du {{ new Date(contactRequest.createdAt).toLocaleDateString('fr-FR') }}.</small></p>
    </div>
</body>
</html>